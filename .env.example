# ChatConnect local development
CHATCONNECT_HOST_PORT=18085
CHATCONNECT_BIND_IP=127.0.0.1
# Set a strong unique local DB password before first startup.
# Never commit .env or expose PostgreSQL publicly.
CHATCONNECT_DB_PASSWORD=change-this-local-password-to-a-long-unique-one
# For trusted LAN testing only, uncomment the following and use a firewall:
# CHATCONNECT_BIND_IP=0.0.0.0
